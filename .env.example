# Copy this file to .env and fill in real values for your machine.
# .env is gitignored — never commit it.

# Your public Google Calendar ID (e.g. abc123@group.calendar.google.com or your@gmail.com)
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# Google API Key for public calendars (no OAuth needed for public calendars)
GOOGLE_API_KEY=YOUR_API_KEY_HERE

# WhatsApp number that finished cart orders and deck reservations are sent
# to, international format without "+" or spaces (e.g. 598 + area + number
# for Uruguay).
LIGA_WHATSAPP_NUMBER=59800000000

# Shared secret to view deck reservations at /prestamo-mazos/reservas?token=...
# Leave blank to disable that page entirely.
LIGA_ADMIN_TOKEN=

# Optional: overrides the default port (8080).
# SERVER_PORT=8080

# Optional: where sign-ups and deck reservations are persisted as JSON
# files (signups.json, deck-reservations.json), so they survive an app
# restart. Defaults to ./data. On a host like Render/Fly, point this at a
# mounted persistent disk/volume — otherwise it's wiped on every redeploy
# just like the old in-memory-only behavior. Leave blank to disable the
# files and go back to in-memory only.
# LIGA_DATA_DIR=./data
